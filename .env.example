# Copy to .env.local and fill in. Never commit .env.local.
# Every integration is optional: missing values switch that feature off gracefully.

# --- AI Asistan (Google AI Studio → https://aistudio.google.com/apikey). Server-only.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.1-flash-lite / gemini-3.8-flash).
# AI_MODEL_CHAT=
# AI_MODEL_DEEP=

# --- AI quota store (Upstash Redis). Without these, quotas fall back to in-memory counters (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Accounts (Supabase → Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, used by the billing webhook to write subscriptions.
SUPABASE_SECRET_KEY=

# --- Payments (Lemon Squeezy). Checkout links are public "share" URLs per variant.
NEXT_PUBLIC_LS_CHECKOUT_CREATOR_MONTHLY=
NEXT_PUBLIC_LS_CHECKOUT_CREATOR_YEARLY=
NEXT_PUBLIC_LS_CHECKOUT_STUDIO_MONTHLY=
NEXT_PUBLIC_LS_CHECKOUT_STUDIO_YEARLY=
# Variant ids per tier (comma-separated, monthly and yearly), used by the webhook to map plans.
LS_VARIANTS_CREATOR=
LS_VARIANTS_STUDIO=
# Signing secret from Lemon Squeezy → Settings → Webhooks. Server-only.
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Analytics (Umami, cookieless). Optional.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Public site origin once a host/domain is chosen (sitemap, canonical URLs).
# NEXT_PUBLIC_SITE_URL=https://example.com
