# Copy to .env.local and fill in. Never commit .env.local.

# AI Asistan (Google AI Studio → https://aistudio.google.com/apikey). Server-only: no NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional model overrides (defaults: gemini-3.1-flash-lite / gemini-3.8-flash).
# AI_MODEL_CHAT=
# AI_MODEL_DEEP=

# AI quota store (Upstash Redis). Without these, quotas fall back to in-memory counters (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site origin once a host/domain is chosen (sitemap, canonical URLs).
# NEXT_PUBLIC_SITE_URL=https://example.com
